# Application Environment
NODE_ENV=development
PORT=5000
IS_PRODUCTION=false
API_END_POINT_V1=/api/v1/

# Database
DB_STRING=mongodb://127.0.0.1:27017/sindhi_matrimony

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_SECRET_KEY=sindhi_matrimony_jwt_super_secret_access_key_2026
REFRESH_JWT_SECRET_KEY=sindhi_matrimony_jwt_super_secret_refresh_key_2026
JWT_EXPIRATION=86400
REFRESH_TOKEN_EXPIRATION=604800

# CORS Whitelist (comma separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081
ALLOW_THIRD_PARTY_API_CLIENTS=true

# Maintenance Mode (true/false)
MAINTENANCE=false

# Worker / Background Process Flag (true: runs standalone worker, false: runs in api process)
RUN_BACKGROUND=false

# AWS S3 / Cloudflare R2 Media Uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=sindhi-matrimony-assets
AWS_ENDPOINT_URL=

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Exotel Telephony VoIP
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUB_DOMAIN=api.exotel.com
EXOTEL_CALLER_ID=

# SMS & WhatsApp Gateway (MSG91)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=SINDHI
MSG91_OTP_TEMPLATE_ID=

# Firebase Admin (FCM Push Notifications)
FIREBASE_SERVICE_ACCOUNT_JSON=
